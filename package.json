{
  "name": "server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bunx prisma generate && bun --watch src/index.ts",
    "start": "bunx prisma generate && bun src/index.ts",
    "prisma:generate": "bunx prisma generate",
    "prisma:migrate": "bunx prisma migrate dev --name init --skip-seed",
    "prisma:deploy": "bunx prisma migrate deploy",
    "prisma:studio": "bunx prisma studio",
    "db:seed": "bun src/seed.ts",
    "lint": "bunx biome check .",
    "format": "bunx biome format --write ."
  },
  "dependencies": {
    "@elysiajs/cors": "^1.3.3",
    "@elysiajs/jwt": "^1.3.2",
    "@elysiajs/swagger": "^1.3.1",
    "@prisma/client": "^6.3.0",
    "bcryptjs": "^2.4.3",
    "elysia": "^1.3.8",
    "grammy": "^1.35.0",
    "nodemailer": "^6.9.16"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.7",
    "@types/nodemailer": "^6.4.17",
    "bun-types": "^1.0.19",
    "prisma": "^6.3.0",
    "typescript": "^5.7.3"
  }
}
