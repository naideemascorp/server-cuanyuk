{
  "name": "server-cuanyuk",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun prisma:deploy && bun prisma:generate && bun --watch src/index.ts",
    "start": "bun prisma:deploy && bun prisma:generate && bun src/index.ts",
    "prisma:generate": "bun x prisma generate",
    "prisma:migrate": "bun x prisma migrate dev --name init --skip-seed",
    "prisma:deploy": "bun x prisma migrate deploy",
    "prisma:studio": "bun x prisma studio",
    "db:seed": "bun src/seed.ts",
    "lint": "bun x biome check .",
    "format": "bun x biome format --write ."
  },
  "dependencies": {
    "@prisma/client": "^6.3.0",
    "elysia": "^1.3.8"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "bun-types": "^1.0.19",
    "prisma": "^6.3.0",
    "typescript": "^5.7.3"
  }
}
